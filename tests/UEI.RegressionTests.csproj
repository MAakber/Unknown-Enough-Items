<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="UnityStubs/**/*.cs;OptionalMods/**/*.cs" />
    <Compile Include="../src/UeiModInterop.cs" Link="Production/UeiModInterop.cs" />
    <Compile Include="../src/UeiModels.cs" Link="Production/UeiModels.cs" />
    <Compile Include="../src/UeiCatalog.cs" Link="Production/UeiCatalog.cs" />
    <Compile Include="../src/UeiEntities.cs" Link="Production/UeiEntities.cs" />
    <Compile Include="../src/UeiEntityVisuals.cs" Link="Production/UeiEntityVisuals.cs" />
    <Compile Include="../src/UeiEntityGhost.cs" Link="Production/UeiEntityGhost.cs" />
    <Compile Include="../src/UeiEntityPlacement.cs" Link="Production/UeiEntityPlacement.cs" />
    <Compile Include="../src/UeiWorldSpawning.cs" Link="Production/UeiWorldSpawning.cs" />
    <Compile Include="../src/UeiCheatPolicy.cs" Link="Production/UeiCheatPolicy.cs" />
    <Compile Include="../src/UeiI18n.cs" Link="Production/UeiI18n.cs" />
    <Compile Include="../src/UeiAcquisition.cs" Link="Production/UeiAcquisition.cs" />
    <Compile Include="../src/UeiAcquisitionIndex.cs" Link="Production/UeiAcquisitionIndex.cs" />
    <Compile Include="../src/UeiAcquisitionSupplement.cs" Link="Production/UeiAcquisitionSupplement.cs" />
    <Compile Include="../src/UeiAcquisitionCards.cs" Link="Production/UeiAcquisitionCards.cs" />
    <Compile Include="../src/UeiResourceIndex.cs" Link="Production/UeiResourceIndex.cs" />
    <Compile Include="../src/UeiNativeAcquisition.cs" Link="Production/UeiNativeAcquisition.cs" />
    <Compile Include="../src/UeiInput.cs" Link="Production/UeiInput.cs" />
    <Compile Include="../src/UeiFavorites.cs" Link="Production/UeiFavorites.cs" />
    <Compile Include="../src/UeiCatalogView.cs" Link="Production/UeiCatalogView.cs" />
    <Compile Include="../src/UeiEntryInteraction.cs" Link="Production/UeiEntryInteraction.cs" />
    <ProjectReference Include="UnityStubs/UnityStubs.csproj" />
    <ProjectReference Include="OptionalMods/OptionalMods.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyOptionalFixtures" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)OptionalMods/bin/$(Configuration)/$(TargetFramework)/UEI.OptionalMods.dll" DestinationFolder="$(OutputPath)" />
  </Target>
</Project>
